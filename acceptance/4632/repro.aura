;; cybrid-systems/aura#4632 (filed from aura-memory): workspace :switch round trips into a child that has had one
;; mutate:rebind cost < 3x those into a never-rebound child (now 5-14x)
(set-code "(define ttl (lambda (cat) 0))\n(define admit (lambda (cat src) #t))")
(eval-current)
(define (trips w n) (let ((t0 (current-time-ms)))
  (let loop ((i 0)) (if (< i n) (begin (workspace :switch w) (workspace :switch 0) (loop (+ i 1)))))
  (max 1 (- (current-time-ms) t0))))
(define a (workspace :create "never"))
(define b (workspace :create "once"))
(workspace :switch b) (eval-current)
(mutate:rebind "ttl" "(lambda (cat) 1)" "r") (eval-current)
(workspace :switch 0) (eval-current)
(define ta (trips a 4000))
(define tb (trips b 4000))
(display (if (< tb (* 3 ta)) "ok" (string-append "slow " (number->string ta) "ms -> " (number->string tb) "ms"))) (newline)
