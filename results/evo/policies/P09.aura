;; aura-memory policy v9 (generated by aura_memory/policy_gen.py from a rule genome)
;; ttl 120, promote 3
(define admit
  (lambda (cat src)
    (cond
          ((and (equal? cat "project") (equal? src "teammate")) #t)
          (else (equal? src "user")))))

(define resolve
  (lambda (cat)
    (cond
          ((equal? cat "pref") "latest")
          ((equal? cat "fact") "keep-first")
          ((equal? cat "project") "latest")
          ((equal? cat "episodic") "latest")
          (else "latest"))))

(define ttl
  (lambda (cat)
    (cond
          ((equal? cat "episodic") 120)
          (else 0))))

(define promote-at
  (lambda (cat)
    (cond
          ((equal? cat "episodic") 3)
          (else 2))))

(define src-weight
  (lambda (src)
    (cond ((equal? src "correction") 3)
          ((equal? src "user") 3)
          ((equal? src "teammate") 1)
          ((equal? src "assistant") 1)
          (else 0))))
