(begin (define admit (lambda (cat src) (if (and (equal? cat "project") (equal? src "teammate")) #t (if (equal? src "user") #t #f)))) (define resolve (lambda (cat) (if (equal? cat "pref") "latest" (if (equal? cat "fact") "keep-first" "latest")))) (define ttl (lambda (cat) (if (equal? cat "episodic") 60 0))) (define promote-at (lambda (cat) 2)) (define src-weight (lambda (src) (if (equal? src "correction") 3 (if (equal? src "user") 3 (if (equal? src "teammate") 1 (if (equal? src "assistant") 1 0)))))))
