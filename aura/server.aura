;; aura-memory control plane server: the memory store, its management policy, the learner and the gate all live
;; in this one Aura process. The host (aura_memory/control.py) only frames requests.
;;
;; Protocol: one request per stdin line (tab-separated), one response per stdout line: "R " + JSON.
;;   EV kind key val cat src noise   stream event; kind = OBS | CORRECT | PIN | QUERY
;;                                   -> {answer, outcome, id, propose, version, size, decayed}
;;   GATE                            trial every pending candidate in its own worldline (store checkpoint +
;;                                   candidate policy), replay the window, KEEP the best one or roll back
;;   APPLY                           ungated: keep the first pending candidate
;;   LIST [cat] | GET key | EDIT id val | DELETE id | PIN id | UNPIN id       white-box memory ops
;;   POLICY | VERSIONS | FIND name | STATS | LEARN 0|1 | PING | QUIT
;;
;; Memory = persistent Aura lists, so a checkpoint (a forked worldline) is O(1): it is the list value itself.
;; Policy = workspace defines admit / resolve / ttl / promote-at / src-weight (policy_seed.aura), rewritten by
;; mutate:rebind from the learner's rule tables and undone with ast:snapshot / ast:restore.

(define *policy-path* (if (getenv "AURA_MEMORY_POLICY") (getenv "AURA_MEMORY_POLICY") "aura/policy_seed.aura"))
(define *min-evidence* (if (getenv "AURA_MEMORY_MIN_EVIDENCE") (string->number (getenv "AURA_MEMORY_MIN_EVIDENCE")) 2))
(define *window* (if (getenv "AURA_MEMORY_WINDOW") (string->number (getenv "AURA_MEMORY_WINDOW")) 100))
(define *ck-every* 20)
(define *sweep-every* 10)
(define *dead-age* 60)
(define *dead-min* 12)

;; ---------------------------------------------------------------- policy rule tables (mirror policy_seed.aura)
(define seed-admit-table (list))                       ;; ("cat\tsrc" . #t/#f), newest first
(define seed-resolve-table (list (cons "pref" "keep-first") (cons "fact" "keep-first")))
(define seed-ttl-table (list))
(define seed-promote-table (list))
(define *admit-table* seed-admit-table)
(define *resolve-table* seed-resolve-table)
(define *ttl-table* seed-ttl-table)
(define *promote-table* seed-promote-table)

(define (q s) (string-append "\"" (string-replace (string-replace s "\\" "\\\\") "\"" "\\\"") "\""))
(define (join-map f xs sep)
  (if (null? xs) "" (if (null? (cdr xs)) (f (car xs)) (string-append (f (car xs)) sep (join-map f (cdr xs) sep)))))
(define (assoc-set tbl k v) (cons (cons k v) (filter (lambda (e) (not (equal? (car e) k))) tbl)))
(define (b->s b) (if b "#t" "#f"))
(define (n->s n) (number->string n))

(define (compile-admit)
  (string-append "(lambda (cat src) (cond "
    (join-map (lambda (e) (let ((cs (string-split (car e) "\t")))
                            (string-append "((and (equal? cat " (q (car cs)) ") (equal? src " (q (cadr cs)) ")) " (b->s (cdr e)) ")")))
              *admit-table* " ")
    " ((equal? src \"user\") #t) (else #f)))"))
(define (compile-cat-table tbl dflt-src)
  (string-append "(lambda (cat) (cond "
    (join-map (lambda (e) (string-append "((equal? cat " (q (car e)) ") " (cdr e) ")")) tbl " ")
    " (else " dflt-src ")))"))
(define (compile-resolve) (compile-cat-table (map (lambda (e) (cons (car e) (q (cdr e)))) *resolve-table*) "\"latest\""))
(define (compile-ttl) (compile-cat-table (map (lambda (e) (cons (car e) (n->s (cdr e)))) *ttl-table*) "0"))
(define (compile-promote) (compile-cat-table (map (lambda (e) (cons (car e) (n->s (cdr e)))) *promote-table*) "2"))

;; ---------------------------------------------------------------- policy calls (memoised per policy version)
(define *pcache* (hash))
(define (pc-clear!) (set! *pcache* (hash)))
(define (memo k thunk)
  (if (hash-has-key? *pcache* k) (hash-ref *pcache* k #f)
      (let ((v (thunk))) (hash-set! *pcache* k v) v)))
(define (p-admit cat src) (memo (string-append "a\t" cat "\t" src) (lambda () (admit cat src))))
(define (p-resolve cat) (memo (string-append "r\t" cat) (lambda () (resolve cat))))
(define (p-ttl cat) (memo (string-append "t\t" cat) (lambda () (ttl cat))))
(define (p-promote cat) (memo (string-append "p\t" cat) (lambda () (promote-at cat))))
(define (p-weight src) (memo (string-append "w\t" src) (lambda () (src-weight src))))

;; ---------------------------------------------------------------- items
;; item = (id key val cat src ts last hits tier pinned pver by)
(define (mk id key val cat src ts last hits tier pinned pver by) (list id key val cat src ts last hits tier pinned pver by))
(define (it-id i) (list-ref i 0)) (define (it-key i) (list-ref i 1)) (define (it-val i) (list-ref i 2))
(define (it-cat i) (list-ref i 3)) (define (it-src i) (list-ref i 4)) (define (it-ts i) (list-ref i 5))
(define (it-last i) (list-ref i 6)) (define (it-hits i) (list-ref i 7)) (define (it-tier i) (list-ref i 8))
(define (it-pinned i) (list-ref i 9)) (define (it-pver i) (list-ref i 10)) (define (it-by i) (list-ref i 11))
(define (it-set i k v)
  (let loop ((xs i) (j 0) (acc (list)))
    (if (null? xs) (reverse acc) (loop (cdr xs) (+ j 1) (cons (if (= j k) v (car xs)) acc)))))
(define (it->hash i)
  (hash "id" (it-id i) "key" (it-key i) "val" (it-val i) "cat" (it-cat i) "src" (it-src i) "ts" (it-ts i)
        "last" (it-last i) "hits" (it-hits i) "tier" (it-tier i) "pinned" (it-pinned i) "policy_version" (it-pver i)
        "by" (it-by i)))
(define (with-key items key) (filter (lambda (i) (equal? (it-key i) key)) items))
(define (without-key items key) (filter (lambda (i) (not (equal? (it-key i) key))) items))
(define (any-pinned xs) (if (null? xs) #f (if (it-pinned (car xs)) #t (any-pinned (cdr xs)))))
(define (find-val xs v) (if (null? xs) #f (if (equal? (it-val (car xs)) v) (car xs) (find-val (cdr xs) v))))
(define (replace-item items new)
  (map (lambda (i) (if (equal? (it-id i) (it-id new)) new i)) items))

;; ---------------------------------------------------------------- store index (persistent, copy-on-write)
;; store = (count root cats occ). root is an 8-ary trie of depth 4 (4096 buckets) built from plain 8-element lists;
;; a bucket is a list of the items whose key hashes there, newest first. A write path-copies 4 nodes and one bucket,
;; so a store value is never mutated after it is built and a checkpoint is still just the value (O(1)), while writes
;; and queries cost O(bucket) instead of O(store). cats = categories ever stored (sweep fast path); occ = hashes of
;; non-empty buckets, so whole-store folds cost O(items). Lists, not vectors: vector-copy is an interpreted std loop
;; (~560 us for 64 slots) and vector->list / list->vector results are never reclaimed. Aura has no persistent map and
;; no string hash primitive (std/hash hash-set is hash-set!), hence this.
(define *nb* 4096)
(define *divs* (list 512 64 8 1))
(define empty-node (list #f #f #f #f #f #f #f #f))
;; Bucket hash of a key from its length and 5 sampled characters: O(1), because a full fold costs ~50 us interpreted
;; (no native string hash) and memoising it in a hash table is worse at scale (hash-ref scans every slot, so a miss
;; is O(table): ~0.8 ms at 40k keys). Collisions only make buckets longer; they never change results.
(define (kc k i) (char->integer (string-ref k i)))
(define (key-hash k)
  (let ((n (string-length k)))
    (if (= n 0) 0
        (modulo (+ (* 7 n) (* 31 (kc k 0)) (* 961 (kc k (- n 1))) (* 29791 (kc k (quotient n 2)))
                   (if (> n 1) (* 923521 (kc k (- n 2))) 0) (if (> n 2) (* 3 (kc k (- n 3))) 0))
                *nb*))))
(define (lset xs k v) (if (= k 0) (cons v (cdr xs)) (cons (car xs) (lset (cdr xs) (- k 1) v))))
(define (t-ref node h divs)
  (cond ((not node) (list)) ((null? divs) node) (else (t-ref (list-ref node (modulo (quotient h (car divs)) 8)) h (cdr divs)))))
(define (t-set node h divs b)
  (if (null? divs) b
      (let* ((n (if node node empty-node)) (k (modulo (quotient h (car divs)) 8)))
        (lset n k (t-set (list-ref n k) h (cdr divs) b)))))
(define st-empty (list 0 #f (list) (list)))
(define (st-count s) (car s))
(define (st-cats s) (caddr s))
(define (st-occ s) (list-ref s 3))
(define (st-bucket s h) (t-ref (cadr s) h *divs*))
(define (st-put s h b delta cat)
  (let ((was (not (null? (st-bucket s h)))) (now (not (null? b))))
    (list (+ (st-count s) delta) (t-set (cadr s) h *divs* b)
          (if (or (not cat) (member cat (st-cats s))) (st-cats s) (cons cat (st-cats s)))
          (cond ((and now (not was)) (cons h (st-occ s)))
                ((and was (not now)) (filter (lambda (x) (not (= x h))) (st-occ s)))
                (else (st-occ s))))))
(define (st-key s key) (with-key (st-bucket s (key-hash key)) key))
;; fold f over every item (bucket order); st->list restores the old global order (newest id first)
(define (st-fold f acc s)
  (let hl ((hs (st-occ s)) (acc acc))
    (if (null? hs) acc
        (hl (cdr hs) (let bl ((xs (st-bucket s (car hs))) (acc acc))
                       (if (null? xs) acc (bl (cdr xs) (f (car xs) acc))))))))
(define (by-id-desc xs) (sort xs (lambda (a b) (> (it-id a) (it-id b)))))
(define (st->list s) (by-id-desc (st-fold cons (list) s)))
(define (st-filter pred s) (by-id-desc (st-fold (lambda (i acc) (if (pred i) (cons i acc) acc)) (list) s)))
(define (st-count-if pred s) (st-fold (lambda (i n) (if (pred i) (+ n 1) n)) 0 s))
;; replace / drop one item (located by its key bucket)
(define (st-replace s new)
  (let ((h (key-hash (it-key new)))) (st-put s h (replace-item (st-bucket s h) new) 0 #f)))
(define (st-drop s it)
  (let ((h (key-hash (it-key it))))
    (st-put s h (filter (lambda (i) (not (equal? (it-id i) (it-id it)))) (st-bucket s h)) -1 #f)))
(define (st-find-id s id) (let ((r (st-filter (lambda (i) (equal? (it-id i) id)) s))) (if (null? r) #f (car r))))

;; ---------------------------------------------------------------- store transitions (pure; shared by live + replay)
;; write -> (list items outcome id)
(define (store-write st key val cat src ts pver)
  (let* ((h (key-hash key)) (b (st-bucket st h)) (ex (with-key b key)) (nx (length ex)))
    (if (equal? src "correction")
        (let ((it (mk ts key val cat src ts ts 0 "st" (any-pinned ex) pver "correction")))
          (if (equal? (p-resolve cat) "keep-both")
              (list (st-put st h (cons it b) 1 cat) "corrected" ts)
              (list (st-put st h (cons it (without-key b key)) (- 1 nx) cat) "corrected" ts)))
        (if (not (p-admit cat src))
            (list st "rejected" -1)
            (if (null? ex)
                (list (st-put st h (cons (mk ts key val cat src ts ts 0 "st" #f pver "admit") b) 1 cat) "added" ts)
                (if (and (any-pinned ex) (not (equal? src "user")))
                    (list st "lost-pinned" -1)
                    (let ((same (find-val ex val)))
                      (if same
                          (list (st-put st h (replace-item b (it-set same 6 ts)) 0 #f) "dup" (it-id same))
                          (let ((r (p-resolve cat)))
                            (cond ((equal? r "keep-first") (list st "lost-conflict" -1))
                                  ((equal? r "keep-both")
                                   (list (st-put st h (cons (mk ts key val cat src ts ts 0 "st" #f pver "admit") b) 1 cat)
                                         "added" ts))
                                  (else
                                   (list (st-put st h (cons (mk ts key val cat src ts ts 0 "st" (any-pinned ex) pver "admit")
                                                            (without-key b key))
                                                 (- 1 nx) cat)
                                         "replaced" ts))))))))))))

(define (rank-score i) (+ (it-ts i) (* 20 (p-weight (it-src i)))))
(define (best-of xs)
  (let loop ((xs (cdr xs)) (b (car xs)))
    (if (null? xs) b (loop (cdr xs) (if (> (rank-score (car xs)) (rank-score b)) (car xs) b)))))
;; query -> (list items answer id)
(define (store-query st key cat now)
  (let ((ex (st-key st key)))
    (if (null? ex)
        (list st "" -1)
        (let* ((b (best-of ex))
               (h (+ 1 (it-hits b)))
               (nb (it-set (it-set (it-set b 7 h) 6 now) 8 (if (>= h (p-promote (it-cat b))) "lt" (it-tier b)))))
          (list (st-replace st nb) (it-val b) (it-id b))))))
(define (keep-item? i now)
  (or (it-pinned i) (equal? (it-tier i) "lt")
      (let ((t (p-ttl (it-cat i)))) (or (= t 0) (<= (- now (it-last i)) t)))))
;; sweep -> (list kept dropped).  Fast path: no stored category has a ttl, so nothing can expire (the common case;
;; the full sweep is O(store) and ran every *sweep-every* events).  Otherwise rebuild only the buckets that drop items.
(define (any-ttl? cs) (if (null? cs) #f (if (> (p-ttl (car cs)) 0) #t (any-ttl? (cdr cs)))))
(define (store-sweep st now)
  (if (not (any-ttl? (st-cats st)))
      (list st (list))
      (let ((dropped (st-filter (lambda (i) (not (keep-item? i now))) st)))
        (list (let loop ((s st) (ds dropped)) (if (null? ds) s (loop (st-drop s (car ds)) (cdr ds)))) dropped))))
(define (store-pin st key flag)
  (let ((h (key-hash key)))
    (st-put st h (map (lambda (i) (if (equal? (it-key i) key) (it-set i 9 flag) i)) (st-bucket st h)) 0 #f)))

;; one stream event -> (list items outcome id answer dropped)
;; ev = (ts kind key val cat src label)
(define (ev-ts e) (list-ref e 0)) (define (ev-kind e) (list-ref e 1)) (define (ev-key e) (list-ref e 2))
(define (ev-val e) (list-ref e 3)) (define (ev-cat e) (list-ref e 4)) (define (ev-src e) (list-ref e 5))
(define (ev-label e) (list-ref e 6))
(define (apply-ev items ev pver)
  (let* ((ts (ev-ts ev))
         (sw (if (= 0 (modulo ts *sweep-every*)) (store-sweep items ts) (list items (list))))
         (items (car sw)) (dropped (cadr sw)) (kind (ev-kind ev)))
    (cond ((equal? kind "QUERY")
           (let ((r (store-query items (ev-key ev) (ev-cat ev) ts))) (list (car r) "query" (caddr r) (cadr r) dropped)))
          ((equal? kind "PIN") (list (store-pin items (ev-key ev) #t) "pinned" -1 "" dropped))
          ((equal? kind "CORRECT")
           (let ((r (store-write items (ev-key ev) (ev-val ev) (ev-cat ev) "correction" ts pver)))
             (list (car r) (cadr r) (caddr r) "" dropped)))
          (else
           (let ((r (store-write items (ev-key ev) (ev-val ev) (ev-cat ev) (ev-src ev) ts pver)))
             (list (car r) (cadr r) (caddr r) "" dropped))))))

;; ---------------------------------------------------------------- live state
(define *items* st-empty)    ;; store index (see above)
(define *events* (list))      ;; newest first
(define *obs* (list))         ;; newest first: (ts key val cat src outcome id)
(define *prov* (list))        ;; newest first: (ts op id key val actor pver detail)
(define *ckpts* (list))       ;; newest first: (ts items)
(define *version* 0)
(define *vlog* (list))        ;; newest first, hashes
(define *learn* #t)
(define *pending* #f)         ;; (list cands why sig evidence)
(define *evidence* (hash))
(define *blacklist* (hash))
(define *seed-snap* -1)
(define *dead-flag* (hash))

(define (prov! op id key val actor detail)
  (set! *prov* (cons (list (if (null? *events*) 0 (ev-ts (car *events*))) op id key val actor *version* detail) *prov*)))
(define (prov->hash p)
  (hash "ts" (list-ref p 0) "op" (list-ref p 1) "id" (list-ref p 2) "key" (list-ref p 3) "val" (list-ref p 4)
        "actor" (list-ref p 5) "policy_version" (list-ref p 6) "detail" (list-ref p 7)))
(define (obs->hash o)
  (hash "ts" (list-ref o 0) "key" (list-ref o 1) "val" (list-ref o 2) "cat" (list-ref o 3) "src" (list-ref o 4)
        "outcome" (list-ref o 5) "id" (list-ref o 6)))

;; ---------------------------------------------------------------- learner
(define (cand->str c) (join-map (lambda (x) (if (string? x) x (n->s x))) c "\t"))
(define (tbl-ref tbl k dflt) (let ((e (assoc k tbl))) (if e (cdr e) dflt)))
(define cats (list "pref" "fact" "project" "episodic"))
(define srcs (list "user" "assistant" "chatter" "teammate"))
;; fix space for the noise ablation (a mis-attributed diagnosis maps deterministically to one of these)
(define fix-space
  (append (apply append (map (lambda (c) (map (lambda (s) (list "admit" c s "flip")) srcs)) cats))
          (apply append (map (lambda (c) (list (list "resolve" c "latest") (list "resolve" c "keep-first") (list "resolve" c "keep-both"))) cats))
          (map (lambda (c) (list "ttl" c 30)) cats)
          (map (lambda (c) (list "promote" c 1)) cats)))
(define (str-hash s) (apply + (map char->integer (string->list s))))
(define (resolve-flip c)
  (if (and (equal? (car c) "admit") (equal? (list-ref c 3) "flip"))
      (list "admit" (list-ref c 1) (list-ref c 2) (if (p-admit (list-ref c 1) (list-ref c 2)) "0" "1"))
      c))

(define (find-obs pred)
  (let loop ((xs *obs*)) (if (null? xs) #f (if (pred (car xs)) (car xs) (loop (cdr xs))))))

;; diagnose a correction: why did memory not hold `val` for `key`?  -> (list why cands)
(define (diagnose key val cat ts)
  (let ((o (find-obs (lambda (o) (and (equal? (list-ref o 1) key) (equal? (list-ref o 2) val) (< (list-ref o 0) ts)
                                       (not (equal? (list-ref o 5) "decayed")))))))
    (if (not o)
        (list "unseen" (list))
        (let ((out (list-ref o 5)) (src (list-ref o 4)) (id (list-ref o 6)))
          (cond
            ((equal? out "rejected") (list "rejected" (list (list "admit" cat src "1"))))
            ((equal? out "lost-conflict")
             (list "lost-conflict" (list (list "resolve" cat "latest") (list "resolve" cat "keep-both"))))
            ((equal? out "lost-pinned") (list "pinned" (list)))
            (else
             (let ((dec (find-obs (lambda (d) (and (equal? (list-ref d 5) "decayed") (equal? (list-ref d 6) id))))))
               (if dec
                   (let ((t (p-ttl cat)) (p (p-promote cat)))
                     (list "decayed" (append (list (list "ttl" cat (* 2 t)))
                                             (if (> p 1) (list (list "promote" cat (- p 1))) (list)))))
                   (let ((rep (find-obs (lambda (r) (and (equal? (list-ref r 1) key) (> (list-ref r 0) (list-ref o 0))
                                                         (or (equal? (list-ref r 5) "replaced") (equal? (list-ref r 5) "added"))
                                                         (not (equal? (list-ref r 2) val)))))))
                     (if (and rep (not (equal? (list-ref rep 4) "user")) (not (equal? (list-ref rep 4) "correction")))
                         (list "overwritten" (list (list "admit" cat (list-ref rep 4) "0")))
                         (if (equal? (p-resolve cat) "keep-both")
                             (list "outranked" (list (list "resolve" cat "latest")))
                             (list "unexplained" (list)))))))))))))

;; a candidate that would not change the current policy is not a proposal
(define (noop-cand? c)
  (let ((kind (car c)) (cat (cadr c)))
    (cond ((equal? kind "admit") (and (not (equal? (list-ref c 3) "flip")) (eq? (p-admit cat (caddr c)) (equal? (list-ref c 3) "1"))))
          ((equal? kind "resolve") (equal? (p-resolve cat) (caddr c)))
          ((equal? kind "ttl") (= (p-ttl cat) (caddr c)))
          ((equal? kind "promote") (= (p-promote cat) (caddr c)))
          (else #t))))
(define (live-cands cs) (filter (lambda (c) (not (noop-cand? c))) cs))
(define (allowed? sig n) (let ((at (hash-ref *blacklist* sig 0))) (or (= at 0) (>= n (* 2 at)))))
(define (consider! why cands0)
  (let ((cands (live-cands cands0)))
    (if (or (not *learn*) *pending* (null? cands))
        #f
        (let* ((sig (cand->str (car cands)))
               (n (+ 1 (hash-ref *evidence* sig 0))))
          (hash-set! *evidence* sig n)
          (if (and (>= n *min-evidence*) (allowed? sig n))
              (begin (set! *pending* (list cands why sig n)) #t)
              #f)))))

;; size pressure: categories with many never-retrieved, untouched, unpinned short-term items
(define (dead-count cat now)
  (st-count-if (lambda (i) (and (equal? (it-cat i) cat) (not (it-pinned i)) (equal? (it-tier i) "st")
                                   (= 0 (it-hits i)) (> (- now (it-last i)) *dead-age*)))
               *items*))
(define (size-check! now)
  (let loop ((cs cats))
    (if (or (null? cs) *pending* (not *learn*)) #f
        (let* ((c (car cs)) (n (dead-count c now)) (sig (string-append "ttl\t" c)))
          (if (and (>= n *dead-min*) (= 0 (p-ttl c)) (allowed? sig n))
              (begin (set! *pending* (list (list (list "ttl" c *dead-age*) (list "ttl" c (* 2 *dead-age*)))
                                           (string-append "size: " (n->s n) " dead items in " c) sig n))
                     #t)
              (loop (cdr cs)))))))

;; ---------------------------------------------------------------- applying / undoing candidates
(define (rebind! name body why)
  (let ((r (try (mutate:rebind name body why) (catch (e) (list "error" e)))))
    (eq? r #t)))
(define (apply-cand! c)
  (let* ((c (resolve-flip c)) (kind (car c)) (cat (cadr c)) (why (cand->str c)))
    (let ((ok (cond ((equal? kind "admit")
                     (set! *admit-table* (assoc-set *admit-table* (string-append cat "\t" (caddr c)) (equal? (list-ref c 3) "1")))
                     (rebind! "admit" (compile-admit) why))
                    ((equal? kind "resolve")
                     (set! *resolve-table* (assoc-set *resolve-table* cat (caddr c)))
                     (rebind! "resolve" (compile-resolve) why))
                    ((equal? kind "ttl")
                     (set! *ttl-table* (assoc-set *ttl-table* cat (caddr c)))
                     (rebind! "ttl" (compile-ttl) why))
                    ((equal? kind "promote")
                     (set! *promote-table* (assoc-set *promote-table* cat (caddr c)))
                     (rebind! "promote-at" (compile-promote) why))
                    (else #f))))
      (let ((ev (try (begin (eval-current) #t) (catch (e) #f))))
        (pc-clear!)
        (and ok ev)))))
(define (tables) (list *admit-table* *resolve-table* *ttl-table* *promote-table*))
(define (set-tables! t)
  (set! *admit-table* (list-ref t 0)) (set! *resolve-table* (list-ref t 1))
  (set! *ttl-table* (list-ref t 2)) (set! *promote-table* (list-ref t 3)))

;; ---------------------------------------------------------------- gate: replay the window in forked worldlines
(define (pick-ckpt now)
  (let loop ((cs *ckpts*) (last #f))
    (if (null? cs) last
        (if (<= (car (car cs)) (- now *window*)) (car cs) (loop (cdr cs) (car cs))))))
(define (window-events from)
  (let loop ((es *events*) (acc (list)))
    (if (or (null? es) (< (ev-ts (car es)) from)) acc (loop (cdr es) (cons (car es) acc)))))
;; -> (list correct labeled size).  User corrections are labels, not inputs: the counterfactual worldline has to
;; keep memory right on its own, so CORRECT events are skipped (their value already labels the query they answer).
(define (replay items evs)
  (let loop ((items items) (evs evs) (ok 0) (n 0))
    (if (null? evs)
        (list ok n (st-count items))
        (let* ((e (car evs))
               (r (if (equal? (ev-kind e) "CORRECT") (list items "skip" -1 "" (list)) (apply-ev items e *version*)))
               (lab (ev-label e)))
          (if (and (equal? (ev-kind e) "QUERY") (not (equal? lab "")))
              (loop (car r) (cdr evs) (if (equal? (list-ref r 3) lab) (+ ok 1) ok) (+ n 1))
              (loop (car r) (cdr evs) ok n))))))
(define (score->hash s) (hash "correct" (car s) "labeled" (cadr s) "size" (caddr s)))
(define (better? s b)
  (or (> (car s) (car b))
      (and (= (car s) (car b)) (< (* 10 (caddr s)) (* 9 (caddr b))))))

(define (log-version! kind cands chosen why scores window t0 snap)
  (set! *vlog* (cons (hash "version" *version* "ts" (if (null? *events*) 0 (ev-ts (car *events*))) "verdict" kind
                           "candidates" (map cand->str cands) "chosen" (if chosen (cand->str chosen) #f) "why" why
                           "scores" scores "window" window "ms" (- (current-time-ms) t0) "snap" snap)
                     *vlog*)))

(define (gate!)
  (let* ((p *pending*) (cands (list-ref p 0)) (why (list-ref p 1)) (sig (list-ref p 2)) (n (list-ref p 3))
         (t0 (current-time-ms)) (now (if (null? *events*) 0 (ev-ts (car *events*))))
         (ck (pick-ckpt now)) (cts (if ck (car ck) 0)) (citems (if ck (cadr ck) st-empty))
         (evs (window-events cts))
         (base (replay citems evs))
         (t (tables))
         (snap (ast:snapshot (string-append "gate-" (n->s now))))
         (scores (map (lambda (c)
                        (let ((ok (apply-cand! c)))
                          (let ((s (if ok (replay citems evs) (list -1 0 0))))
                            (ast:restore snap) (eval-current) (set-tables! t) (pc-clear!)
                            s)))
                      cands)))
    (set! *pending* #f)
    (let loop ((cs cands) (ss scores) (bc #f) (bs base))
      (if (null? cs)
          (let ((sh (cons (score->hash base) (map score->hash scores))))
            (if bc
                (begin (apply-cand! bc) (set! *version* (+ *version* 1))
                       (log-version! "KEEP" cands (resolve-flip bc) why sh (list cts now) t0 snap)
                       (prov! "policy" -1 "" (cand->str (resolve-flip bc)) "learner" why)
                       (hash "verdict" "KEEP" "chosen" (cand->str (resolve-flip bc)) "scores" sh "version" *version*))
                (begin (hash-set! *blacklist* sig n)
                       (log-version! "ROLLBACK" cands #f why sh (list cts now) t0 snap)
                       (hash "verdict" "ROLLBACK" "chosen" #f "scores" sh "version" *version*))))
          (if (better? (car ss) bs) (loop (cdr cs) (cdr ss) (car cs) (car ss)) (loop (cdr cs) (cdr ss) bc bs))))))

(define (apply-ungated!)
  (let* ((p *pending*) (c (car (list-ref p 0))) (t0 (current-time-ms)))
    (set! *pending* #f)
    (apply-cand! c)
    (set! *version* (+ *version* 1))
    (log-version! "KEEP-UNGATED" (list-ref p 0) (resolve-flip c) (list-ref p 1) (list) (list) t0 -1)
    (prov! "policy" -1 "" (cand->str (resolve-flip c)) "learner" (list-ref p 1))
    (hash "verdict" "KEEP" "chosen" (cand->str (resolve-flip c)) "version" *version*)))

;; ---------------------------------------------------------------- live event handling
(define (pend->hash)
  (if *pending* (hash "candidates" (map cand->str (list-ref *pending* 0)) "why" (list-ref *pending* 1)) #f))

(define (live-event! kind key val cat src noise)
  (let* ((ts (if (null? *events*) 0 (+ 1 (ev-ts (car *events*)))))
         (ev (list ts kind key val cat src "")))
    (if (= 0 (modulo ts *ck-every*))
        (set! *ckpts* (let ((c (cons (list ts *items*) *ckpts*))) (if (> (length c) 12) (reverse (cdr (reverse c))) c)))
        #f)
    ;; a correction labels the query it answers (for replay scoring)
    (if (and (equal? kind "CORRECT") (not (null? *events*)) (equal? (ev-kind (car *events*)) "QUERY")
             (equal? (ev-key (car *events*)) key))
        (set! *events* (cons (it-set (car *events*) 6 val) (cdr *events*)))
        #f)
    (let* ((r (apply-ev *items* ev *version*))
           (out (list-ref r 1)) (id (list-ref r 2)) (ans (list-ref r 3)) (dropped (list-ref r 4)))
      (set! *items* (car r))
      (set! *events* (cons (if (equal? kind "QUERY") (it-set ev 6 ans) ev) *events*))
      (map (lambda (d) (set! *obs* (cons (list ts (it-key d) (it-val d) (it-cat d) (it-src d) "decayed" (it-id d)) *obs*))
                       (prov! "decay" (it-id d) (it-key d) (it-val d) "policy" (string-append "ttl " (n->s (p-ttl (it-cat d))))))
           dropped)
      (cond ((equal? kind "QUERY") (prov! "retrieve" id key ans "agent" ""))
            ((equal? kind "PIN") (prov! "pin" -1 key "" "user" ""))
            (else
             (set! *obs* (cons (list ts key val cat (if (equal? kind "CORRECT") "correction" src) out id) *obs*))
             (if (or (equal? out "rejected") (equal? out "lost-conflict") (equal? out "lost-pinned"))
                 (prov! out -1 key val src "")
                 (prov! out id key val (if (equal? kind "CORRECT") "user" src) ""))))
      (if (equal? kind "CORRECT")
          (let* ((d (diagnose key val cat ts))
                 (cands (if (and (equal? noise "1") (not (null? (cadr d))))
                            (list (list-ref fix-space (modulo (str-hash (cand->str (car (cadr d)))) (length fix-space))))
                            (cadr d))))
            (consider! (string-append (car d) " " key) cands))
          #f)
      (if (= (modulo ts 50) 49) (size-check! ts) #f)
      (hash "ts" ts "answer" ans "outcome" out "id" id "propose" (pend->hash) "version" *version*
            "size" (st-count *items*) "decayed" (length dropped)))))

;; ---------------------------------------------------------------- white-box ops
(define (all-true xs) (if (null? xs) #t (if (car xs) (all-true (cdr xs)) #f)))
(define (table-admit c s) (let ((e (assoc (string-append c "\t" s) *admit-table*))) (if e (cdr e) (equal? s "user"))))
(define (find-item id) (st-find-id *items* id))
(define (user-op! op id f)
  (let ((it (find-item id)))
    (if (not it) (hash "error" (string-append "no item " (n->s id)))
        (let ((new (f it)))
          (set! *items* (if new (st-replace *items* new) (st-drop *items* it)))
          (prov! op id (it-key it) (if new (it-val new) (it-val it)) "user" "white-box")
          (hash "ok" #t "item" (if new (it->hash new) #f))))))

;; ---------------------------------------------------------------- protocol
(define (reply h) (display "R ") (display (json-encode h)) (newline))
(define (field fs i) (if (< i (length fs)) (list-ref fs i) ""))
(define (fnum fs i) (string->number (field fs i)))

(define (handle fs)
  (let ((cmd (field fs 0)))
    (cond
      ((equal? cmd "EV") (reply (live-event! (field fs 1) (field fs 2) (field fs 3) (field fs 4) (field fs 5) (field fs 6))))
      ((equal? cmd "GATE") (reply (if *pending* (gate!) (hash "error" "no pending proposal"))))
      ((equal? cmd "ADDCAND")    ;; extra candidate from an external proposer (e.g. an LLM), same grammar as the learner's
       (if *pending*
           (let ((c (list (field fs 1) (field fs 2)
                          (if (or (equal? (field fs 1) "ttl") (equal? (field fs 1) "promote")) (fnum fs 3) (field fs 3))
                          (field fs 4))))
             (if (and (member (car c) (list "admit" "resolve" "ttl" "promote")) (member (cadr c) cats)
                      (not (noop-cand? c)))
                 (begin (set! *pending* (cons (append (car *pending*) (list c)) (cdr *pending*)))
                        (reply (hash "ok" #t "candidates" (map cand->str (car *pending*)))))
                 (reply (hash "ok" #f "reason" "rejected candidate"))))
           (reply (hash "error" "no pending proposal"))))
      ((equal? cmd "APPLY") (reply (if *pending* (apply-ungated!) (hash "error" "no pending proposal"))))
      ((equal? cmd "LIST")
       (reply (hash "items" (map it->hash (if (equal? (field fs 1) "") (st->list *items*)
                                              (st-filter (lambda (i) (equal? (it-cat i) (field fs 1))) *items*))))))
      ((equal? cmd "GET")
       (let ((k (field fs 1)))
         (reply (hash "items" (map it->hash (st-key *items* k))
                      "observations" (map obs->hash (filter (lambda (o) (equal? (list-ref o 1) k)) *obs*))
                      "provenance" (map prov->hash (filter (lambda (p) (equal? (list-ref p 3) k)) *prov*))))))
      ((equal? cmd "EDIT") (reply (user-op! "edit" (fnum fs 1) (lambda (i) (it-set (it-set i 2 (field fs 2)) 11 "user-edit")))))
      ((equal? cmd "DELETE") (reply (user-op! "delete" (fnum fs 1) (lambda (i) #f))))
      ((equal? cmd "PIN") (reply (user-op! "pin" (fnum fs 1) (lambda (i) (it-set i 9 #t)))))
      ((equal? cmd "UNPIN") (reply (user-op! "unpin" (fnum fs 1) (lambda (i) (it-set i 9 #f)))))
      ((equal? cmd "POLICY")
       (reply (hash "source" (current-source :workspace) "version" *version*
                    "compiled" (hash "admit" (compile-admit) "resolve" (compile-resolve) "ttl" (compile-ttl)
                                     "promote-at" (compile-promote)))))
      ((equal? cmd "VERSIONS") (reply (hash "versions" (reverse *vlog*) "version" *version*)))
      ((equal? cmd "FIND")
       (reply (hash "name" (field fs 1) "node" (let ((r (try (query :find (field fs 1)) (catch (e) #f))))
                                                  (if (number? r) r #f)))))
      ((equal? cmd "STATS")
       (reply (hash "size" (st-count *items*) "events" (length *events*) "observations" (length *obs*)
                    "provenance" (length *prov*) "version" *version* "pending" (pend->hash)
                    "by_cat" (map (lambda (c) (list c (st-count-if (lambda (i) (equal? (it-cat i) c)) *items*))) cats))))
      ((equal? cmd "CHECK")      ;; workspace policy agrees with the compiled tables (used by tests)
       (reply (hash "agree" (and (all-true (map (lambda (c) (all-true (map (lambda (s) (eq? (admit c s) (table-admit c s))) srcs))) cats))
                                 (all-true (map (lambda (c) (and (equal? (resolve c) (tbl-ref *resolve-table* c "latest"))
                                                                 (= (ttl c) (tbl-ref *ttl-table* c 0))
                                                                 (= (promote-at c) (tbl-ref *promote-table* c 2)))) cats))))))
      ((equal? cmd "LEARN") (set! *learn* (equal? (field fs 1) "1")) (reply (hash "learn" *learn*)))
      ((equal? cmd "PING") (reply (hash "pong" #t "version" *version*)))
      (else (reply (hash "error" (string-append "unknown command: " cmd)))))))

(define (serve)
  (let ((line (read-line)))
    (if (or (eof-object? line) (equal? line "QUIT"))
        #t
        (begin (handle (string-split line "\t")) (serve)))))

(define (load-policy)
  (set-code (read-file *policy-path*))
  (eval-current)
  (set! *seed-snap* (ast:snapshot "seed")))

(load-policy)
(reply (hash "ready" #t "seed_snap" *seed-snap* "policy" *policy-path*))
(serve)
